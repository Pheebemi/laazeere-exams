# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave unset for local SQLite. In production (Vercel), set
# DATABASE_URL to Neon's POOLED connection string (the "-pooler" hostname).
DATABASE_URL=

# raddai-backend integration
RADDAI_API_BASE_URL=https://laazeereacademy.pw/api
EXAM_PORTAL_API_KEY=

# Static files
STATIC_ROOT=staticfiles

# Security (set to True once served over HTTPS in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
DJANGO_CSRF_TRUSTED_ORIGINS=
